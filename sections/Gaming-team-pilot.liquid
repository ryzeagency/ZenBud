{% comment %}
  Gaming-team-pilot.liquid

  Desktop reference: 1920px
  Required content container: 90vw

  The random XD hover / prototype lines visible in the supplied
  screenshot are intentionally not reproduced.

  Typography follows the established gaming-page baseline:
  - Heading: 1.87vw
  - Paragraph: 0.83vw
  - Mobile heading: 7vw
  - Mobile paragraph: 3.8vw
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    display: flex;
    --gaming-team-page-bg: {{ section.settings.page_bg }};
    --gaming-team-card-bg: {{ section.settings.card_bg }};
    --gaming-team-text: {{ section.settings.text_color }};
    --gaming-team-button-bg: {{ section.settings.button_bg }};
    --gaming-team-button-text: {{ section.settings.button_text_color }};
    --gaming-team-glow: {{ section.settings.glow_color }};

    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--gaming-team-page-bg);
  }

  #shopify-section-{{ section.id }} *,
  #shopify-section-{{ section.id }} *::before,
  #shopify-section-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .gaming-team__container {
    position: relative;

    width: 90vw;
    max-width: 90vw;
    min-height: 20.8vw;

    margin: 0 auto;
    padding: 3vw 3.1vw 2.65vw;

    overflow: hidden;

    background-color: var(--gaming-team-card-bg);
    border-radius: 0.85vw;
  }

  /* ========================================
     SUBTLE LOWER-RIGHT GLOW
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-team__container::after {
    content: "";
    position: absolute;
    z-index: 1;

    right: -6vw;
    bottom: -9vw;

    width: 19vw;
    height: 19vw;

    border-radius: 50%;

    background: radial-gradient(
      circle,
      var(--gaming-team-glow) 0%,
      rgba(0, 0, 0, 0) 68%
    );

    opacity: {{ section.settings.glow_opacity | divided_by: 100.0 }};
    filter: blur(1.4vw);

    pointer-events: none;
  }

  /* ========================================
     OPTIONAL BACKGROUND IMAGE
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-team__background {
    position: absolute;
    z-index: 1;
    inset: 0;

    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .gaming-team__background-image {
    display: block;

    width: 100%;
    height: 100%;
    max-width: none;

    object-fit: cover;
    object-position: {{ section.settings.background_position }};
  }

  #shopify-section-{{ section.id }} .gaming-team__content {
    position: relative;
    z-index: 3;

    width: 100%;
    max-width: 80vw;
  }

  #shopify-section-{{ section.id }} .gaming-team__heading {
    margin: 0 0 1vw;

    color: var(--gaming-team-text);

    font-family: inherit;
    font-size: 1.87vw;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .gaming-team__text {
    max-width: 78vw;

    margin: 0;

    color: var(--gaming-team-text);

    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 400;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .gaming-team__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .gaming-team__text p + p {
    margin-top: 0.8em;
  }

  #shopify-section-{{ section.id }} .gaming-team__note {
    max-width: 77vw;

    margin-top: 1.25vw;

    color: var(--gaming-team-text);

    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 400;
    font-style: italic;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .gaming-team__note p {
    margin: 0;
  }

  /* ========================================
     BUTTON
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-team__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 22.5vw;

    margin-top: 1.65vw;
    padding: 0.93vw 2.08vw;

    background-color: var(--gaming-team-button-bg);
    color: var(--gaming-team-button-text);

    border: 0;
    border-radius: 2.6vw;

    font-family: inherit;
    font-size: 0.73vw;
    font-weight: 600;
    line-height: 1;
    text-align: center;
    text-decoration: none;

    transition:
      opacity 0.3s ease,
      transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} a.gaming-team__button:hover {
    color: var(--gaming-team-button-text);
    opacity: 0.9;
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} a.gaming-team__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  /* ========================================
     TABLET
     ======================================== */

  @media screen and (min-width: 767px) and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .gaming-team__container {
      min-height: 30vw;
      padding: 4.5vw;
      border-radius: 1.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-team__heading {
      font-size: 3vw;
    }

    #shopify-section-{{ section.id }} .gaming-team__text,
    #shopify-section-{{ section.id }} .gaming-team__note {
      max-width: 100%;
      font-size: 1.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-team__button {
      min-width: 30vw;
      padding: 1vw 3vw;
      font-size: 1.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-team__container::after {
      width: 28vw;
      height: 28vw;
    }
  }

  /* ========================================
     MOBILE
     ======================================== */

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .gaming-team__container {
      width: 90vw;
      max-width: 90vw;

      min-height: 0;

      padding: 8vw 6vw;

      border-radius: 4vw;
    }

    #shopify-section-{{ section.id }} .gaming-team__content {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .gaming-team__heading {
      margin-bottom: 4vw;
      font-size: 7vw;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .gaming-team__text,
    #shopify-section-{{ section.id }} .gaming-team__note {
      max-width: 100%;
      font-size: 3.8vw;
      line-height: 1.6;
    }

    #shopify-section-{{ section.id }} .gaming-team__note {
      margin-top: 5vw;
    }

    #shopify-section-{{ section.id }} .gaming-team__button {
      width: 100%;
      min-width: 0;

      margin-top: 6vw;
      padding: 4vw 6vw;

      border-radius: 8vw;

      font-size: 3.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-team__container::after {
      right: -20vw;
      bottom: -20vw;

      width: 60vw;
      height: 60vw;

      filter: blur(4vw);
    }
  }
</style>

{%- liquid
  assign team_bg_alt = section.settings.background_image.alt | default: ''
-%}

<div class="gaming-team__container">

  {%- if section.settings.background_image != blank or section.settings.background_asset_filename != blank -%}
    <div
      class="gaming-team__background"
      aria-hidden="true"
    >
      {%- if section.settings.background_image != blank -%}
        {{
          section.settings.background_image
          | image_url: width: 2200
          | image_tag:
            class: 'gaming-team__background-image',
            loading: 'lazy',
            widths: '750, 1000, 1250, 1500, 1800, 2200',
            sizes: '90vw',
            alt: team_bg_alt
        }}
      {%- else -%}
        <img
          class="gaming-team__background-image"
          src="{{ section.settings.background_asset_filename | asset_url }}"
          alt=""
          loading="lazy"
          width="2200"
          height="900"
        >
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="gaming-team__content">

    {%- if section.settings.heading != blank -%}
      <h2 class="gaming-team__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="gaming-team__text">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <div class="gaming-team__note">
        {{ section.settings.note }}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      {%- if section.settings.button_link != blank -%}
        <a
          href="{{ section.settings.button_link }}"
          class="gaming-team__button"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- else -%}
        <span class="gaming-team__button">
          {{ section.settings.button_label | escape }}
        </span>
      {%- endif -%}
    {%- endif -%}

  </div>

</div>

{% schema %}
{
  "name": "Gaming-Team Pilot",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For teams, coaches, and creators."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>ZenBud is opening limited pilot slots for collegiate esports programs, amateur competitive teams, coaches, streamers, performance labs, and gaming creators. Pilot participants can run structured pre/post testing across multiple sessions and submit aggregate results.</p>"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Italic note",
      "default": "<p><em>Team pilots should include baseline testing, repeated sessions, and clear separation between measured results and subjective feedback.</em></p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Request a Team Pilot"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Optional background image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "background_asset_filename",
      "label": "Fallback asset filename",
      "info": "Optional. Enter the exact theme asset filename only."
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background image position",
      "default": "center center",
      "options": [
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "page_bg",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#3367DD"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Lower-right glow"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#234F13"
    },
    {
      "type": "range",
      "id": "glow_opacity",
      "label": "Glow opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 35
    }
  ],
  "presets": [
    {
      "name": "Gaming-Team Pilot",
      "category": "Home Revamp"
    }
  ]
}
{% endschema %}