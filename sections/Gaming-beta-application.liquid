{% comment %}
  Gaming-beta-application.liquid

  Functional Shopify Online Store 2.0 gaming beta application form.
  Uses Shopify's native contact form submission.

  Desktop reference: 1920px
  Main container: 90vw

  Typography follows the established Gaming page:
  - Heading: 1.87vw
  - Paragraph / fields: 0.83vw
  - Button: 0.73vw
  - Mobile heading: 7vw
  - Mobile paragraph / fields: 3.8vw
  - Mobile button: 3.5vw

  Form fields are blocks so labels, types, required states,
  and select options can be edited/reordered in the Theme Editor.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    display: flex;
    --gaming-form-bg: {{ section.settings.background_color }};
    --gaming-form-heading: {{ section.settings.heading_color }};
    --gaming-form-text: {{ section.settings.text_color }};
    --gaming-form-accent: {{ section.settings.accent_color }};
    --gaming-form-input-bg: {{ section.settings.input_background }};
    --gaming-form-input-text: {{ section.settings.input_text_color }};
    --gaming-form-border: {{ section.settings.input_border_color }};
    --gaming-form-button: {{ section.settings.button_color }};
    --gaming-form-button-text: {{ section.settings.button_text_color }};
    --gaming-form-success: {{ section.settings.success_color }};
    --gaming-form-error: {{ section.settings.error_color }};

    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--gaming-form-bg);
  }

  #shopify-section-{{ section.id }} *,
  #shopify-section-{{ section.id }} *::before,
  #shopify-section-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* ========================================
     90VW CONTAINER
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-beta-form__container {
    width: 90vw;
    max-width: 90vw;

    margin: 0 auto;

    padding-top: {{ section.settings.padding_top }}vw;
    padding-bottom: {{ section.settings.padding_bottom }}vw;
  }

  /*
    The mockup content begins inset from the 90vw container
    rather than directly against its left edge.
  */
  #shopify-section-{{ section.id }} .gaming-beta-form__inner {
    width: 64vw;
    max-width: 64vw;
    margin-left: 5vw;
  }

  /* ========================================
     HEADER
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-beta-form__header {
    width: 100%;
    margin-bottom: 1.55vw;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__eyebrow {
    margin: 0 0 0.3vw;

    color: var(--gaming-form-accent);

    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__heading {
    margin: 0;

    color: var(--gaming-form-heading);

    font-family: inherit;
    font-size: 1.87vw;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__intro {
    max-width: 62vw;

    margin-top: 0.45vw;

    color: var(--gaming-form-text);

    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 400;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__intro p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__intro p + p {
    margin-top: 0.75em;
  }

  /* ========================================
     SHOPIFY STATUS MESSAGES
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-beta-form__status {
    width: 100%;

    margin: 0 0 1.5vw;
    padding: 0.8vw 1vw;

    border: 1px solid currentColor;
    border-radius: 0.35vw;

    font-family: inherit;
    font-size: 0.83vw;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__status--success {
    color: var(--gaming-form-success);
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__status--error {
    color: var(--gaming-form-error);
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__status ul {
    margin: 0.4em 0 0;
    padding-left: 1.25em;
  }

  /* ========================================
     FORM GRID
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-beta-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    column-gap: 4.35vw;
    row-gap: 1.15vw;

    width: 100%;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__field {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__field--full {
    grid-column: 1 / -1;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__label {
    display: block;

    margin: 0 0 0.35vw;

    color: var(--gaming-form-heading);

    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 500;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__required {
    color: var(--gaming-form-error);
  }

  /* ========================================
     INPUTS
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-beta-form__input,
  #shopify-section-{{ section.id }} .gaming-beta-form__select {
    display: block;

    width: 100%;
    height: 2.55vw;

    margin: 0;
    padding: 0 0.8vw;

    background-color: var(--gaming-form-input-bg);
    color: var(--gaming-form-input-text);

    border: 1px solid var(--gaming-form-border);
    border-radius: 0.35vw;

    box-shadow: none;

    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 400;
    line-height: 1;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__input::placeholder {
    color: var(--gaming-form-input-text);
    opacity: 0.45;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__input:hover,
  #shopify-section-{{ section.id }} .gaming-beta-form__select:hover {
    border-color: var(--gaming-form-heading);
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__input:focus,
  #shopify-section-{{ section.id }} .gaming-beta-form__select:focus {
    border-color: var(--gaming-form-accent);
    outline: none;

    box-shadow: 0 0 0 1px var(--gaming-form-accent);
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__select {
    cursor: pointer;
  }

  /* ========================================
     ACKNOWLEDGEMENT
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-beta-form__acknowledgement {
    grid-column: 1 / -1;

    display: flex;
    align-items: flex-start;
    gap: 0.75vw;

    width: 100%;

    margin-top: 0.8vw;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__checkbox {
    flex: 0 0 auto;

    width: 1.15vw;
    height: 1.15vw;

    margin: 0.1vw 0 0;

    accent-color: var(--gaming-form-accent);
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__acknowledgement-text {
    max-width: 59vw;

    margin: 0;

    color: var(--gaming-form-text);

    font-family: inherit;
    font-size: 0.73vw;
    font-weight: 400;
    line-height: 1.45;

    cursor: pointer;
  }

  /* ========================================
     SUBMIT
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-beta-form__submit-wrapper {
    grid-column: 1 / -1;

    margin-top: 0.65vw;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 17.75vw;

    margin: 0;
    padding: 0.93vw 2.08vw;

    background-color: var(--gaming-form-button);
    color: var(--gaming-form-button-text);

    border: 0;
    border-radius: 2.6vw;

    cursor: pointer;

    font-family: inherit;
    font-size: 0.73vw;
    font-weight: 600;
    line-height: 1;
    text-align: center;
    text-decoration: none;

    transition:
      opacity 0.3s ease,
      transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__submit:hover {
    color: var(--gaming-form-button-text);
    opacity: 0.9;
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .gaming-beta-form__submit:focus-visible {
    outline: 2px solid var(--gaming-form-accent);
    outline-offset: 3px;
  }

  /* ========================================
     TABLET
     ======================================== */

  @media screen and (min-width: 767px) and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .gaming-beta-form__container {
      padding-top: 7.5vw;
      padding-bottom: 7.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__inner {
      width: 80vw;
      max-width: 80vw;
      margin-left: 2vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__eyebrow,
    #shopify-section-{{ section.id }} .gaming-beta-form__intro,
    #shopify-section-{{ section.id }} .gaming-beta-form__label,
    #shopify-section-{{ section.id }} .gaming-beta-form__input,
    #shopify-section-{{ section.id }} .gaming-beta-form__select,
    #shopify-section-{{ section.id }} .gaming-beta-form__status {
      font-size: 1.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__heading {
      font-size: 3vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__grid {
      column-gap: 4vw;
      row-gap: 2vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__input,
    #shopify-section-{{ section.id }} .gaming-beta-form__select {
      height: 4.2vw;
      padding: 0 1.4vw;
      border-radius: 0.6vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__acknowledgement {
      gap: 1.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__checkbox {
      width: 2vw;
      height: 2vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__acknowledgement-text {
      max-width: 72vw;
      font-size: 1.35vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__submit {
      min-width: 27vw;

      padding: 1vw 3vw;

      font-size: 1.5vw;
    }
  }

  /* ========================================
     MOBILE
     ======================================== */

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .gaming-beta-form__container {
      width: 90vw;
      max-width: 90vw;

      padding-top: {{ section.settings.mobile_padding_top }}vw;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__inner {
      width: 100%;
      max-width: 100%;

      margin-left: 0;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__header {
      margin-bottom: 7vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__eyebrow {
      margin-bottom: 2vw;

      font-size: 3.8vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__heading {
      font-size: 7vw;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__intro {
      max-width: 100%;

      margin-top: 3vw;

      font-size: 3.8vw;
      line-height: 1.6;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__status {
      margin-bottom: 5vw;
      padding: 3vw;

      border-radius: 2vw;

      font-size: 3.8vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__grid {
      grid-template-columns: 1fr;

      column-gap: 0;
      row-gap: 5vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__field,
    #shopify-section-{{ section.id }} .gaming-beta-form__field--full {
      grid-column: 1;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__label {
      margin-bottom: 2vw;

      font-size: 3.8vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__input,
    #shopify-section-{{ section.id }} .gaming-beta-form__select {
      height: 13vw;

      padding: 0 4vw;

      border-radius: 2vw;

      font-size: 3.8vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__acknowledgement {
      grid-column: 1;

      gap: 3vw;

      margin-top: 2vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__checkbox {
      width: 5.5vw;
      height: 5.5vw;

      margin-top: 0.6vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__acknowledgement-text {
      max-width: none;

      font-size: 3.4vw;
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__submit-wrapper {
      grid-column: 1;

      margin-top: 2vw;
    }

    #shopify-section-{{ section.id }} .gaming-beta-form__submit {
      width: 100%;
      min-width: 0;

      padding: 4vw 6vw;

      border-radius: 8vw;

      font-size: 3.5vw;
    }
  }
</style>

<div class="gaming-beta-form__container">

  <div class="gaming-beta-form__inner">

    <header class="gaming-beta-form__header">

      {%- if section.settings.eyebrow != blank -%}
        <p class="gaming-beta-form__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="gaming-beta-form__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <div class="gaming-beta-form__intro">
          {{ section.settings.intro }}
        </div>
      {%- endif -%}

    </header>

    {%- liquid
    assign gaming_beta_form_id = 'GamingBetaApplication-' | append: section.id
    -%}

    {%- form 'contact', id: gaming_beta_form_id, class: 'gaming-beta-form__form' -%}

      <input
        type="hidden"
        name="contact[Application Type]"
        value="ZenBud Gaming Beta Application"
      >

      {%- if form.posted_successfully? -%}
        <div
          class="gaming-beta-form__status gaming-beta-form__status--success"
          role="status"
          tabindex="-1"
          autofocus
        >
          {{ section.settings.success_message | escape }}
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div
          class="gaming-beta-form__status gaming-beta-form__status--error"
          role="alert"
          tabindex="-1"
          autofocus
        >
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="gaming-beta-form__grid">

        {%- for block in section.blocks -%}

          {%- case block.type -%}

            {%- when 'field' -%}

              {%- liquid
                assign field_id = 'GamingBetaField-' | append: section.id | append: '-' | append: block.id
                assign field_name = block.settings.field_name | default: block.settings.label

                if block.settings.field_type == 'email'
                  assign contact_name = 'contact[email]'
                else
                  assign contact_name = 'contact[' | append: field_name | append: ']'
                endif
              -%}

              <div
                class="gaming-beta-form__field{% if block.settings.width == 'full' %} gaming-beta-form__field--full{% endif %}"
                {{ block.shopify_attributes }}
              >

                {%- if block.settings.label != blank -%}
                  <label
                    class="gaming-beta-form__label"
                    for="{{ field_id }}"
                  >
                    {{ block.settings.label | escape }}

                    {%- if block.settings.required -%}
                      <span
                        class="gaming-beta-form__required visually-hidden"
                      >
                        *
                      </span>
                    {%- endif -%}
                  </label>
                {%- endif -%}

                {%- if block.settings.field_type == 'select' -%}

                  {%- assign select_options = block.settings.options | split: ',' -%}

                  <select
                    id="{{ field_id }}"
                    class="gaming-beta-form__select"
                    name="{{ contact_name }}"
                    {% if block.settings.required %}required{% endif %}
                  >
                    {%- for option in select_options -%}
                      {%- assign clean_option = option | strip -%}

                      {%- if clean_option != blank -%}
                        <option value="{{ clean_option | escape }}">
                          {{ clean_option | escape }}
                        </option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>

                {%- else -%}

                  <input
                    id="{{ field_id }}"
                    class="gaming-beta-form__input"
                    type="{{ block.settings.field_type }}"
                    name="{{ contact_name }}"
                    {% if block.settings.placeholder != blank %}
                      placeholder="{{ block.settings.placeholder | escape }}"
                    {% endif %}
                    {% if block.settings.field_type == 'email' %}
                      autocomplete="email"
                      autocapitalize="off"
                      spellcheck="false"
                    {% elsif field_name == 'Name' %}
                      autocomplete="name"
                    {% endif %}
                    {% if block.settings.required %}required{% endif %}
                  >

                {%- endif -%}

              </div>

            {%- when 'acknowledgement' -%}

              {%- assign acknowledgement_id = 'GamingBetaAcknowledgement-' | append: section.id -%}

              <div
                class="gaming-beta-form__acknowledgement"
                {{ block.shopify_attributes }}
              >
                <input
                  id="{{ acknowledgement_id }}"
                  class="gaming-beta-form__checkbox"
                  type="checkbox"
                  name="contact[Gaming Beta Acknowledgement]"
                  value="Accepted"
                  required
                >

                <label
                  class="gaming-beta-form__acknowledgement-text"
                  for="{{ acknowledgement_id }}"
                >
                  {{ block.settings.text | escape }}
                </label>
              </div>

          {%- endcase -%}

        {%- endfor -%}

        <div class="gaming-beta-form__submit-wrapper">
          <button
            type="submit"
            class="gaming-beta-form__submit"
          >
            {{ section.settings.submit_label | escape }}
          </button>
        </div>

      </div>

    {%- endform -%}

  </div>

</div>

{% schema %}
{
  "name": "Gaming-Beta Application",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "APPLY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Apply for the ZenBud Gaming Beta"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>This beta is for gamers willing to test ZenBud’s reaction-readiness protocol with structured pre/post measurement. ZenBud is not currently proven to improve in-game performance.</p>"
    },
    {
      "type": "header",
      "content": "Submission"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Submit Beta Application"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for applying. Your ZenBud Gaming Beta application has been received."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "vw",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "vw",
      "default": 3.5
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "vw",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "vw",
      "default": 10
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading and label color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#3367DD"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border color",
      "default": "#B5B5B5"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#3367DD"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "success_color",
      "label": "Success message color",
      "default": "#167A35"
    },
    {
      "type": "color",
      "id": "error_color",
      "label": "Error color",
      "default": "#C62828"
    }
  ],
  "blocks": [
    {
      "type": "field",
      "name": "Form field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Name"
        },
        {
          "type": "text",
          "id": "field_name",
          "label": "Submission field name",
          "default": "Name",
          "info": "This is the label shown in the submitted contact email."
        },
        {
          "type": "select",
          "id": "field_type",
          "label": "Field type",
          "default": "text",
          "options": [
            {
              "value": "text",
              "label": "Text"
            },
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "number",
              "label": "Number"
            },
