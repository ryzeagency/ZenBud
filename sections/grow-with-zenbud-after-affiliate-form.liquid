{% comment %}
  grow-with-zenbud-after-affiliate-form.liquid

  Copy rewrite applied from zenbud_link_rewrite.docx (Pages 5 and 6).

  Contains three blocks:
    1. Why Partner With ZenBud  - five evidence points (was three short tiles)
    2. Ready to Get Started     - the two partner CTAs
    3. Clinical rep contact     - replaces the old retail "Support your nervous
                                  system" banner, which sent practitioners to a
                                  consumer purchase instead of to a person.

  New styles are prefixed .zb-ev- and .zb-rep- and scoped to this section, so
  grow-with-zenbud-split.css is untouched.
{% endcomment %}

{{ 'grow-with-zenbud-split.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign call_href = s.call_number | remove: '-' | remove: ' ' | remove: '(' | remove: ')' | remove: '.'
  assign text_href = s.text_number | remove: '-' | remove: ' ' | remove: '(' | remove: ')' | remove: '.'
  assign booking_url = s.rep_button_url | default: 'https://meetings-na2.hubspot.com/hmosgrove'
-%}

{%- style -%}
.grow-with-zenbud .why-partner-section {
        padding: 0 7.5vw;
    }
    footer > section:first-child {
    display: none !important;
}
  /* ---------- Why Partner: evidence points ---------- */
  .grow-with-zenbud--after-affiliate .zb-ev-box {
    background: {{ s.card_background }};
    border-radius: 20px;
    padding: clamp(28px, 4vw, 56px);
    color: {{ s.card_text_color }};
  }
  .grow-with-zenbud--after-affiliate .zb-ev-head {
    display: grid;
    grid-template-columns: minmax(220px, 34%) 1fr;
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    padding-bottom: clamp(24px, 3vw, 40px);
    margin-bottom: clamp(24px, 3vw, 40px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .grow-with-zenbud--after-affiliate .zb-ev-head img {
    width: 100%;
    height: auto;
    display: block;
  }
  .grow-with-zenbud--after-affiliate .zb-ev-title {
    color: {{ s.card_heading_color }};
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    line-height: 1.15;
    margin: 0 0 14px;
  }
  .grow-with-zenbud--after-affiliate .zb-ev-lede {
    margin: 0;
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    line-height: 1.6;
    max-width: 62ch;
    opacity: 0.88;
  }
  .grow-with-zenbud--after-affiliate .zb-ev-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 2.6vw, 36px);
  }
  .grow-with-zenbud--after-affiliate .zb-ev-item {
    border-left: 2px solid {{ s.accent_color }};
    padding-left: 18px;
    color: #fff;
  }
  .grow-with-zenbud--after-affiliate .zb-ev-item:last-child {
    grid-column: 1 / -1;
  }
  .grow-with-zenbud--after-affiliate .zb-ev-item h4 {
    color: {{ s.accent_color }};
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    font-weight: 700;
    margin: 0 0 8px;
    line-height: 1.3;
  }
  .grow-with-zenbud--after-affiliate .zb-ev-item p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.65;
    opacity: 0.85;
  }
  .grow-with-zenbud--after-affiliate .zb-ev-item em {
    font-style: italic;
    opacity: 1;
  }

  /* ---------- Clinical rep card ---------- */
  .grow-with-zenbud--after-affiliate .zb-rep-card {
    background: {{ s.card_background }};
    border-radius: 20px;
    padding: clamp(28px, 4vw, 52px);
    color: {{ s.card_text_color }};
    max-width: 1080px;
    margin: clamp(28px, 4vw, 48px) auto 0;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-heading {
    color: {{ s.card_heading_color }};
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.18;
    margin: 0 0 10px;
    max-width: 22ch;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-lede {
    margin: 0 0 clamp(26px, 3.4vw, 40px);
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    line-height: 1.6;
    max-width: 56ch;
    opacity: 0.85;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-body {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-person {
    display: flex;
    gap: 18px;
    align-items: center;
    margin-bottom: 22px;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-photo {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    flex: 0 0 auto;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-name {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 2px;
    color: {{ s.card_heading_color }};
  }
  .grow-with-zenbud--after-affiliate .zb-rep-role {
    margin: 0;
    font-size: 0.88rem;
    opacity: 0.72;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-contact li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 0.95rem;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-contact-label {
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0.55;
    min-width: 44px;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-contact a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.26);
    padding-bottom: 1px;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-contact a:hover {
    border-bottom-color: {{ s.accent_color }};
  }
  .grow-with-zenbud--after-affiliate .zb-rep-options-title {
    font-size: 0.74rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0.6;
    margin: 0 0 16px;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-option {
    border-left: 2px solid {{ s.accent_color }};
    padding: 2px 0 2px 16px;
    margin-bottom: 18px;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-option-title {
    font-weight: 700;
    margin: 0 0 4px;
    color: {{ s.card_heading_color }};
    font-size: 0.98rem;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-option-desc {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    opacity: 0.82;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-cta {
    display: inline-block;
    margin-top: 10px;
    padding: 15px 30px;
    border-radius: 999px;
    background: {{ s.accent_color }};
    color: {{ s.button_text_color }};
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .grow-with-zenbud--after-affiliate .zb-rep-cta:hover { opacity: 0.88; }
  .grow-with-zenbud--after-affiliate .zb-rep-card :focus-visible {
    outline: 2px solid {{ s.accent_color }};
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .grow-with-zenbud--after-affiliate .zb-ev-head {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .grow-with-zenbud--after-affiliate .zb-ev-head img {
      max-width: 260px;
      margin: 0 auto;
    }
    .grow-with-zenbud--after-affiliate .zb-ev-lede { margin-inline: auto; }
    .grow-with-zenbud--after-affiliate .zb-ev-grid { grid-template-columns: 1fr; }
    .grow-with-zenbud--after-affiliate .zb-ev-item:last-child { grid-column: auto; }
    .grow-with-zenbud--after-affiliate .zb-rep-body { grid-template-columns: 1fr; }
    .grow-with-zenbud--after-affiliate .zb-rep-heading { max-width: none; }
  }
{%- endstyle -%}

<div class="grow-with-zenbud grow-with-zenbud--after-affiliate">
    <section class="container-fluid why-partner-section">
        <div class="zb-ev-box">
            <div class="zb-ev-head">
                <img src="https://cdn.shopify.com/s/files/1/0858/0713/7087/files/zenbud-headphones.png?v=1773803361" alt="ZenBud headset" loading="lazy">
                <div>
                    <h2 class="zb-ev-title">Why Partner With ZenBud?</h2>
                    <p class="zb-ev-lede">Most wellness devices ask you to take their word for it. This one has a published safety profile, a validated sham, and a mechanism you can explain to a patient in sixty seconds.</p>
                </div>
            </div>

            <div class="zb-ev-grid">
                <div class="zb-ev-item">
                    <h4>Peer-Reviewed, Not Self-Reported</h4>
                    <p>Published in <em>Brain Sciences</em> (University of Nottingham) and <em>JMIR Neurotechnology</em>, with a registered clinical trial (NCT06574971). The Nottingham work was independently funded &mdash; NeurGear had no role in design, analysis, or the decision to publish.</p>
                </div>

                <div class="zb-ev-item">
                    <h4>A Validated Placebo Control</h4>
                    <p>Nottingham researchers built a sham ZenBud and tested whether people could tell the difference. James' Blinding Index came back 0.9 for the active device and 1.0 for sham &mdash; high to perfect blinding. That's the prerequisite for real controlled trials, and almost no consumer wellness device has cleared it.</p>
                </div>

                <div class="zb-ev-item">
                    <h4>Documented Safety, Not Assumed Safety</h4>
                    <p>In the same crossover trial, adverse effects were mild, transient, and no more frequent than with the inactive sham &mdash; mostly skin sensation participants attributed to headset pressure rather than stimulation. CE compliant, 29-minute hardware cutoff.</p>
                </div>

                <div class="zb-ev-item">
                    <h4>Anatomically Targeted</h4>
                    <p>The cymba concha is one of the only surface-accessible sites innervated by the auricular branch of the vagus nerve, which is almost entirely afferent. fMRI shows stimulation there engages the NTS, locus coeruleus, and insula &mdash; with none of the off-target carotid and sympathetic activation that comes with cervical approaches.</p>
                </div>

                <div class="zb-ev-item">
                    <h4>Ultrasound Held Its Own Against Electrical</h4>
                    <p>In a 59-participant sham-controlled crossover, ultrasound taVNS shifted emotional bias toward positive interpretation comparably to electrical taVNS &mdash; no significant difference between modalities. Same result, no current, no tingling, no electrode placement.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="container-fluid cta-section">
        <div class="row">
            <div class="col-12 d-flex flex-column align-items-center text-center">
                <h2 class="cta-heading">Ready to Get Started?</h2>

                <div class="cta-buttons d-flex justify-content-center">
                    <a href="{{ s.wholesale_url | default: '/pages/wholesale' }}" class="btn-cta btn-orange-cta">{{ s.wholesale_label | default: 'Open a Wholesale Account' }}</a>
                    <a href="{{ s.affiliate_url | default: 'https://partners.zenbud.health/' }}" class="btn-cta btn-blue-cta">{{ s.affiliate_label | default: 'Join the Affiliate Program' }}</a>
                </div>
            </div>
        </div>

        {%- if s.show_rep -%}
            <div class="zb-rep-card">
                {%- if s.rep_heading != blank -%}
                    <h3 class="zb-rep-heading">{{ s.rep_heading }}</h3>
                {%- endif -%}
                {%- if s.rep_lede != blank -%}
                    <p class="zb-rep-lede">{{ s.rep_lede }}</p>
                {%- endif -%}

                <div class="zb-rep-body">
                    <div>
                        <div class="zb-rep-person">
                            {%- if s.rep_photo != blank -%}
                                <img class="zb-rep-photo" src="{{ s.rep_photo | image_url: width: 200 }}" alt="{{ s.rep_name | escape }}" width="84" height="84" loading="lazy">
                            {%- endif -%}
                            <div>
                                <p class="zb-rep-name">{{ s.rep_name }}</p>
                                <p class="zb-rep-role">{{ s.rep_role }}</p>
                            </div>
                        </div>

                        <ul class="zb-rep-contact">
                            {%- if s.call_number != blank -%}
                                <li>
                                    <span class="zb-rep-contact-label">Call</span>
                                    <a href="tel:{{ s.dial_prefix }}{{ call_href }}">{{ s.call_number }}</a>
                                </li>
                            {%- endif -%}
                            {%- if s.text_number != blank -%}
                                <li>
                                    <span class="zb-rep-contact-label">Text</span>
                                    <a href="sms:{{ s.dial_prefix }}{{ text_href }}">{{ s.text_number }}</a>
                                </li>
                            {%- endif -%}
                            {%- if s.rep_email != blank -%}
                                <li>
                                    <span class="zb-rep-contact-label">Email</span>
                                    <a href="mailto:{{ s.rep_email }}">{{ s.rep_email }}</a>
                                </li>
                            {%- endif -%}
                        </ul>
                    </div>

                    <div>
                        {%- if s.options_title != blank -%}
                            <p class="zb-rep-options-title">{{ s.options_title }}</p>
                        {%- endif -%}

                        {%- for block in section.blocks -%}
                            {%- if block.type == 'option' -%}
                                <div class="zb-rep-option" {{ block.shopify_attributes }}>
                                    <p class="zb-rep-option-title">{{ block.settings.title }}</p>
                                    <p class="zb-rep-option-desc">{{ block.settings.description }}</p>
                                </div>
                            {%- endif -%}
                        {%- endfor -%}

                        {%- if s.rep_button_label != blank -%}
                            <a class="zb-rep-cta" href="{{ booking_url }}" {% if s.rep_button_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ s.rep_button_label }}</a>
                        {%- endif -%}
                    </div>
                </div>
            </div>
        {%- endif -%}
    </section>
</div>

{% schema %}
{
  "name": "Grow with ZenBud bottom",
  "tag": "section",
  "class": "section full-width",
  "settings": [
    {
      "type": "header",
      "content": "Ready to Get Started buttons"
    },
    {
      "type": "text",
      "id": "wholesale_label",
      "label": "Wholesale button label",
      "default": "Open a Wholesale Account"
    },
