          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "default": "primary",
          "options": [
            {
              "value": "primary",
              "label": "Primary button"
            },
            {
              "value": "link",
              "label": "Text link"
            }
          ]
        }
      ]
    },
    {
      "type": "reviews",
      "name": "Reviews",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "stars_image",
