{% comment %}
  Gaming-who-this-is-for.liquid

  Desktop reference: 1920px
  Main container: 90vw

  Typography follows the established gaming-page baseline:
  - Main heading: 1.87vw
  - Paragraph: 0.83vw
  - Button/small text baseline: 0.73vw
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --gaming-audience-bg: {{ section.settings.bg_color }};
    --gaming-audience-heading: {{ section.settings.heading_color }};
    --gaming-audience-accent: {{ section.settings.accent_color }};
    --gaming-audience-card-bg: {{ section.settings.card_bg }};
    --gaming-audience-card-text: {{ section.settings.card_text_color }};
    --gaming-audience-divider: {{ section.settings.divider_color }};
    --gaming-audience-exclusion-bg: {{ section.settings.exclusion_bg }};
    --gaming-audience-exclusion-text: {{ section.settings.exclusion_text_color }};

    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--gaming-audience-bg);
  }

  #shopify-section-{{ section.id }} *,
  #shopify-section-{{ section.id }} *::before,
  #shopify-section-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* ========================================
     90VW CONTAINER
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-audience__container {
    width: 90vw;
    max-width: 90vw;
    margin: 0 auto;
    padding-top: 3.2vw;
    padding-bottom: 3.7vw;
  }

  /* ========================================
     SECTION HEADER
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-audience__header {
    margin-left: 3vw;
    margin-bottom: 2.15vw;
  }

  #shopify-section-{{ section.id }} .gaming-audience__eyebrow {
    margin: 0 0 0.35vw;

    color: var(--gaming-audience-accent);
    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gaming-audience__heading {
    margin: 0;

    color: var(--gaming-audience-heading);
    font-family: inherit;
    font-size: 1.87vw;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
  }

  /* ========================================
     COMPLETE PANEL
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-audience__panel {
    width: 100%;
    overflow: hidden;
    border-radius: 0.85vw;
  }

  /* ========================================
     AUDIENCE GRID
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-audience__targets {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));

    width: 100%;

    background-color: var(--gaming-audience-divider);
    gap: 1px;
  }

  #shopify-section-{{ section.id }} .gaming-audience__target {
    display: flex;
    flex-direction: column;
    justify-content: center;

    min-width: 0;

    padding: 2.5vw 3.25vw;

    background-color: var(--gaming-audience-card-bg);
    color: var(--gaming-audience-card-text);
  }

  /*
    First row:
    2 equal cards

    Second row:
    3 equal cards

    Additional audience blocks continue
    as three-column cards.
  */

  #shopify-section-{{ section.id }} .gaming-audience__target:nth-child(1),
  #shopify-section-{{ section.id }} .gaming-audience__target:nth-child(2) {
    grid-column: span 3;
    min-height: 11.9vw;
  }

  #shopify-section-{{ section.id }} .gaming-audience__target:nth-child(n+3) {
    grid-column: span 2;
    min-height: 11.95vw;
  }

  #shopify-section-{{ section.id }} .gaming-audience__target-title {
    margin: 0 0 0.75vw;

    color: var(--gaming-audience-card-text);
    font-family: inherit;
    font-size: 0.93vw;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gaming-audience__target-text {
    max-width: 30vw;
    margin: 0;

    color: var(--gaming-audience-card-text);
    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 400;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .gaming-audience__target-text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .gaming-audience__target-text p + p {
    margin-top: 0.75em;
  }

  /* ========================================
     EXCLUSION AREA
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-audience__exclusions {
    width: 100%;

    padding: 1.8vw 3.05vw 1.65vw;

    background-color: var(--gaming-audience-exclusion-bg);
    color: var(--gaming-audience-exclusion-text);
  }

  #shopify-section-{{ section.id }} .gaming-audience__exclusion-heading {
    margin: 0 0 0.85vw;

    color: var(--gaming-audience-exclusion-text);
    font-family: inherit;
    font-size: 0.93vw;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gaming-audience__exclusion-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 4.5vw;
    row-gap: 0.95vw;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  #shopify-section-{{ section.id }} .gaming-audience__exclusion-item {
    display: grid;
    grid-template-columns: 1vw minmax(0, 1fr);
    align-items: center;
    column-gap: 0.5vw;

    margin: 0;
    padding: 0;

    color: var(--gaming-audience-exclusion-text);
    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 400;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .gaming-audience__cross {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 1vw;
    height: 1vw;

    color: var(--gaming-audience-exclusion-text);

    font-family: Arial, sans-serif;
    font-size: 1vw;
    font-weight: 300;
    line-height: 1;

    opacity: 0.95;
  }

  #shopify-section-{{ section.id }} .gaming-audience__cross img {
    display: block;
    width: 0.8vw;
    height: 0.8vw;
    object-fit: contain;
  }

  /* ========================================
     TABLET
     ======================================== */

  @media screen and (min-width: 767px) and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .gaming-audience__container {
      padding-top: 7.5vw;
      padding-bottom: 7.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__header {
      margin-left: 0;
      margin-bottom: 3vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__eyebrow {
      font-size: 1.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__heading {
      font-size: 3vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__panel {
      border-radius: 1.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__target {
      padding: 3.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__target:nth-child(1),
    #shopify-section-{{ section.id }} .gaming-audience__target:nth-child(2) {
      min-height: 18vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__target:nth-child(n+3) {
      min-height: 19vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__target-title,
    #shopify-section-{{ section.id }} .gaming-audience__target-text,
    #shopify-section-{{ section.id }} .gaming-audience__exclusion-heading,
    #shopify-section-{{ section.id }} .gaming-audience__exclusion-item {
      font-size: 1.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__target-text {
      max-width: none;
    }

    #shopify-section-{{ section.id }} .gaming-audience__exclusions {
      padding: 3vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__exclusion-item {
      grid-template-columns: 1.8vw minmax(0, 1fr);
      gap: 1vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__cross {
      width: 1.8vw;
      height: 1.8vw;
      font-size: 1.8vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__cross img {
      width: 1.4vw;
      height: 1.4vw;
    }
  }

  /* ========================================
     MOBILE
     ======================================== */

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .gaming-audience__container {
      width: 90vw;
      max-width: 90vw;

      padding-top: 10vw;
      padding-bottom: 10vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__header {
      margin-left: 0;
      margin-bottom: 7vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__eyebrow {
      margin-bottom: 2vw;
      font-size: 3.8vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__heading {
      font-size: 7vw;
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .gaming-audience__panel {
      border-radius: 4vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__targets {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .gaming-audience__target:nth-child(1),
    #shopify-section-{{ section.id }} .gaming-audience__target:nth-child(2),
    #shopify-section-{{ section.id }} .gaming-audience__target:nth-child(n+3) {
      grid-column: 1;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .gaming-audience__target {
      padding: 8vw 6vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__target-title {
      margin-bottom: 3vw;
      font-size: 3.8vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__target-text {
      max-width: 100%;
      font-size: 3.8vw;
      line-height: 1.6;
    }

    #shopify-section-{{ section.id }} .gaming-audience__exclusions {
      padding: 7vw 6vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__exclusion-heading {
      margin-bottom: 5vw;
      font-size: 3.8vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__exclusion-list {
      grid-template-columns: 1fr;
      gap: 4vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__exclusion-item {
      grid-template-columns: 5vw minmax(0, 1fr);
      column-gap: 2vw;

      font-size: 3.8vw;
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .gaming-audience__cross {
      width: 5vw;
      height: 5vw;

      font-size: 5vw;
    }

    #shopify-section-{{ section.id }} .gaming-audience__cross img {
      width: 3.5vw;
      height: 3.5vw;
    }
  }
</style>

<div class="gaming-audience__container">

  <header class="gaming-audience__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="gaming-audience__eyebrow">
        {{ section.settings.eyebrow | escape }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="gaming-audience__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}
  </header>

  <div class="gaming-audience__panel">

    {%- assign audience_count = 0 -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'audience' -%}
        {%- assign audience_count = audience_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if audience_count > 0 -%}
      <div class="gaming-audience__targets">

        {%- for block in section.blocks -%}
          {%- if block.type == 'audience' -%}

            <article
              class="gaming-audience__target"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.title != blank -%}
                <h3 class="gaming-audience__target-title">
                  {{ block.settings.title | escape }}
                </h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="gaming-audience__target-text">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
            </article>

          {%- endif -%}
        {%- endfor -%}

      </div>
    {%- endif -%}

    {%- assign exclusion_count = 0 -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'exclusion' -%}
        {%- assign exclusion_count = exclusion_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if exclusion_count > 0 -%}
      <div class="gaming-audience__exclusions">

        {%- if section.settings.exclusion_heading != blank -%}
          <h3 class="gaming-audience__exclusion-heading">
            {{ section.settings.exclusion_heading | escape }}
          </h3>
        {%- endif -%}

        <ul class="gaming-audience__exclusion-list">

          {%- for block in section.blocks -%}
            {%- if block.type == 'exclusion' -%}

              <li
                class="gaming-audience__exclusion-item"
                {{ block.shopify_attributes }}
              >
                <span
                  class="gaming-audience__cross"
                  aria-hidden="true"
                >
                  {%- if section.settings.cross_icon != blank -%}
                    {{
                      section.settings.cross_icon
                      | image_url: width: 80
                      | image_tag:
                        loading: 'lazy',
                        alt: ''
                    }}
                  {%- elsif section.settings.cross_icon_asset_filename != blank -%}
                    <img
                      src="{{ section.settings.cross_icon_asset_filename | asset_url }}"
                      alt=""
                      loading="lazy"
                      width="32"
                      height="32"
                    >
                  {%- else -%}
                    ×
                  {%- endif -%}
                </span>

                <span>
                  {{ block.settings.text | escape }}
                </span>
              </li>

            {%- endif -%}
          {%- endfor -%}

        </ul>

      </div>
    {%- endif -%}

  </div>

</div>

{% schema %}
{
  "name": "Gaming-Who This Is For",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHO THIS IS FOR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for gamers who already measure performance."
    },
    {
      "type": "header",
      "content": "Bottom list"
    },
    {
      "type": "text",
      "id": "exclusion_heading",
      "label": "Bottom list heading",
      "default": "WHO THIS IS FOR"
    },
    {
      "type": "image_picker",
      "id": "cross_icon",
      "label": "Cross icon"
    },
    {
      "type": "text",
      "id": "cross_icon_asset_filename",
      "label": "Cross icon asset filename",
      "info": "Optional. Enter only the exact theme asset filename."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow color",
      "default": "#3367DD"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Audience card background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Audience card text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Audience card dividers",
      "default": "#A0A0A0"
    },
    {
      "type": "color",
      "id": "exclusion_bg",
      "label": "Bottom area background",
      "default": "#808080"
    },
    {
      "type": "color",
      "id": "exclusion_text_color",
      "label": "Bottom area text",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "audience",
      "name": "Audience card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "COMPETITIVE FPS PLAYERS"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>For players who already care about reaction time, crosshair placement, first-shot timing, and aim-training consistency.</p>"
        }
      ]
    },
    {
      "type": "exclusion",
      "name": "Bottom list item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Anyone expecting guaranteed in-game improvement"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gaming-Who This Is For",
      "category": "Home Revamp",
      "blocks": [
        {
          "type": "audience",
          "settings": {
            "title": "COMPETITIVE FPS PLAYERS",
            "text": "<p>For players who already care about reaction time, crosshair placement, first-shot timing, and aim-training consistency.</p>"
          }
        },
        {
          "type": "audience",
          "settings": {
            "title": "PERFORMANCE-FOCUSED ADULT GAMERS",
            "text": "<p>For adults who still compete seriously and want measurable tools to support sharpness.</p>"
          }
        },
        {
          "type": "audience",
          "settings": {
            "title": "MOBA / RTS PLAYERS",
            "text": "<p>For players who care about speed, decision load, focus, and reaction under pressure.</p>"
          }
        },
        {
          "type": "audience",
          "settings": {
            "title": "STREAMERS AND CREATORS",
            "text": "<p>For creators willing to run transparent pre/post reaction tests live or on video.</p>"
          }
        },
        {
          "type": "audience",
          "settings": {
            "title": "COLLEGIATE ESPORTS PROGRAMS",
            "text": "<p>For coaches and program leads who want structured readiness data across a team.</p>"
          }
        },
        {
          "type": "exclusion",
          "settings": {
            "text": "Anyone expecting guaranteed in-game improvement"
          }
        },
        {
          "type": "exclusion",
          "settings": {
            "text": "Anyone unwilling to track baseline and follow-up data"
          }
        },
        {
          "type": "exclusion",
          "settings": {
            "text": "Anyone seeking treatment for a medical condition"
          }
        },
        {
          "type": "exclusion",
          "settings": {
            "text": "Anyone under 18 without appropriate approval"
          }
        }
      ]
    }
  ]
}
{% endschema %}