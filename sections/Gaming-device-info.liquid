{% comment %}
  Gaming-device-info.liquid

  Static gaming device information section.
  Based on the existing ZenBud Device Info layout, but intentionally
  contains NO accordion/details elements and NO accordion JavaScript.

  Desktop reference: 1920px wide.
  Main content container: 90vw.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --gaming-device-bg: {{ section.settings.bg_color }};
    --gaming-device-heading: {{ section.settings.heading_color }};
    --gaming-device-text: {{ section.settings.text_color }};
    --gaming-device-accent: {{ section.settings.accent_color }};
    --gaming-device-card: {{ section.settings.card_bg }};

    position: relative;
    width: 100%;
    background-color: var(--gaming-device-bg);
    overflow: hidden;
    display: flex;
  }

  #shopify-section-{{ section.id }} *,
  #shopify-section-{{ section.id }} *::before,
  #shopify-section-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* ========================================
     MAIN 90VW CONTAINER
     1920px reference height: ~768px
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-device__container {
    position: relative;
    width: 90vw;
    max-width: 90vw;
    height: 40vw;
    min-height: 40vw;
    margin: 0 auto;
  }

  /* ========================================
     BACKGROUND / PRODUCT IMAGE
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-device__image-wrapper {
    position: absolute;
    z-index: 1;
    top: 0;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .gaming-device__bg-image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  #shopify-section-{{ section.id }} .gaming-device__bg-image.placeholder-svg {
    background: #111111;
    fill: #333333;
  }

  /*
    Fade the product photography naturally into the black
    area behind the right-side content.
  */
  #shopify-section-{{ section.id }} .gaming-device__image-wrapper::after {
    content: "";
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    bottom: 0;
    width: 18vw;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.3) 28%,
      rgba(0, 0, 0, 0.75) 67%,
      var(--gaming-device-bg) 100%
    );
  }

  /* ========================================
     RIGHT CONTENT
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-device__content {
    position: absolute;
    z-index: 3;
    top: 6.25vw;
    right: 0;

    width: 35vw;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .gaming-device__subheading {
    margin: 0 0 1.2vw;
    padding: 0;

    color: var(--gaming-device-accent);

    font-family: inherit;
    font-size: 1.02vw;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gaming-device__heading {
    margin: 0;
    padding: 0;

    color: var(--gaming-device-heading);

    font-family: inherit;
    font-size: 2.08vw;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0;
  }

  /* ========================================
     STATIC INFO CARD
     Deliberately NOT an accordion
     ======================================== */

  #shopify-section-{{ section.id }} .gaming-device__card {
    position: relative;

    width: 38.55vw;
    min-height: 20.35vw;

    margin-top: 2.45vw;
    margin-left: -3.5vw;

    padding: 2.55vw 3.5vw;

    display: flex;
    align-items: flex-start;

    color: var(--gaming-device-text);

    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.15);

    border: 0;
    border-radius: 1.65vw;

    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .gaming-device__text {
    width: 100%;

    color: var(--gaming-device-text);

    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 400;
    line-height: 1.33;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .gaming-device__text p {
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .gaming-device__text p + p {
    margin-top: 1.55vw;
  }

  #shopify-section-{{ section.id }} .gaming-device__text a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  #shopify-section-{{ section.id }} .gaming-device__text strong {
    color: inherit;
    font-weight: 700;
  }

  /* ========================================
     TABLET
     ======================================== */

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .gaming-device__container {
      display: flex;
      flex-direction: column;

      width: 90vw;
      max-width: 90vw;
      height: auto;
      min-height: 0;

      padding-top: 6vw;
      padding-bottom: 8vw;
    }

    #shopify-section-{{ section.id }} .gaming-device__image-wrapper {
      position: relative;
      top: auto;
      left: auto;

      width: 100%;
      height: 65vw;

      margin: 0 0 7vw;

      border-radius: 4vw;
    }

    #shopify-section-{{ section.id }} .gaming-device__image-wrapper::after {
      top: auto;
      right: 0;
      bottom: 0;
      left: 0;

      width: 100%;
      height: 30%;

      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0) 0%,
        var(--gaming-device-bg) 100%
      );
    }

    #shopify-section-{{ section.id }} .gaming-device__content {
      position: relative;
      top: auto;
      right: auto;

      width: 100%;
    }

    #shopify-section-{{ section.id }} .gaming-device__subheading {
      margin-bottom: 2.5vw;
      font-size: clamp(14px, 3.5vw, 20px);
    }

    #shopify-section-{{ section.id }} .gaming-device__heading {
      font-size: clamp(30px, 7vw, 48px);
    }

    #shopify-section-{{ section.id }} .gaming-device__card {
      width: 100%;
      min-height: 0;

      margin-top: 5vw;
      margin-left: 0;

      padding: 6vw;

      border-radius: 4vw;
    }

    #shopify-section-{{ section.id }} .gaming-device__text {
      font-size: clamp(16px, 4vw, 22px);
      line-height: 1.45;
    }

    #shopify-section-{{ section.id }} .gaming-device__text p + p {
      margin-top: 4vw;
    }
  }

  /* ========================================
     MOBILE
     ======================================== */

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .gaming-device__container {
      width: 90vw;
      max-width: 90vw;
      padding-top: 5vw;
      padding-bottom: 8vw;
    }

    #shopify-section-{{ section.id }} .gaming-device__image-wrapper {
      height: 78vw;
      margin-bottom: 8vw;
      border-radius: 5vw;
    }

    #shopify-section-{{ section.id }} .gaming-device__bg-image {
      object-position: center;
    }

    #shopify-section-{{ section.id }} .gaming-device__subheading {
      margin-bottom: 3vw;
      font-size: 3.7vw;
    }

    #shopify-section-{{ section.id }} .gaming-device__heading {
      font-size: 7.5vw;
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .gaming-device__card {
      margin-top: 6vw;
      padding: 7vw 6vw;
      border-radius: 5vw;
    }

    #shopify-section-{{ section.id }} .gaming-device__text {
      font-size: 4vw;
      line-height: 1.45;
    }

    #shopify-section-{{ section.id }} .gaming-device__text p + p {
      margin-top: 5vw;
    }
  }
</style>

{%- liquid
  assign device_image_alt = section.settings.image_alt

  if device_image_alt == blank and section.settings.bg_image != blank
    assign device_image_alt = section.settings.bg_image.alt
  endif

  if device_image_alt == blank
    assign device_image_alt = 'ZenBud wearable device'
  endif
-%}

<div class="gaming-device__container">

  <div class="gaming-device__image-wrapper" aria-hidden="true">
    {%- if section.settings.bg_image != blank -%}
      {{
        section.settings.bg_image
        | image_url: width: 2000
        | image_tag:
          class: 'gaming-device__bg-image',
          loading: 'lazy',
          widths: '750, 1000, 1250, 1500, 1750, 2000',
          sizes: '(max-width: 989px) 90vw, 68vw',
          alt: device_image_alt
      }}
    {%- elsif section.settings.bg_asset_filename != blank -%}
      <img
        class="gaming-device__bg-image"
        src="{{ section.settings.bg_asset_filename | asset_url }}"
        alt="{{ device_image_alt | escape }}"
        loading="lazy"
        width="1400"
        height="900"
      >
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'gaming-device__bg-image placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="gaming-device__content">

    {%- if section.settings.subheading != blank -%}
      <p class="gaming-device__subheading h6">
        {{ section.settings.subheading | escape }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="gaming-device__heading h2">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="gaming-device__card">
        <div class="gaming-device__text">
          {{ section.settings.text }}
        </div>
      </div>
    {%- endif -%}

  </div>

</div>

{% schema %}
{
  "name": "Gaming-Meet ZenBud",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Device image"
    },
    {
      "type": "text",
      "id": "bg_asset_filename",
      "label": "Fallback asset filename",
      "info": "Optional. Enter the exact theme asset filename only."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "ZenBud wearable device"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "default": "center center",
      "options": [
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow",
      "default": "ABOUT THE DEVICE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet ZenBud"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>ZenBud is a non-invasive wearable that sits around the ears and uses focused ultrasound to stimulate the auricular branch of the vagus nerve. For general wellness use, ZenBud is designed to support the body’s natural calm and recovery response.</p><p>For gaming, the hypothesis is narrower: a better-regulated nervous system may support faster, cleaner reaction readiness before high-focus play. That hypothesis is now being tested.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#E5E5E5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow color",
      "default": "#3168E4"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#262626"
    }
  ],
  "presets": [
    {
      "name": "Gaming-Meet ZenBud",
      "category": "Home Revamp"
    }
  ]
}
{% endschema %}