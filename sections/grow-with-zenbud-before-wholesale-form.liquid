{% comment %}
  grow-with-zenbud-before-wholesale-form.liquid

  Copy rewrite applied from zenbud_link_rewrite.docx (Pages 1-3).
  Language rule enforced throughout: "margin", never "commission".
{% endcomment %}

{{ 'grow-with-zenbud-split.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Scoped overrides for the rewritten hero. The new headline is longer than
     "GROW WITH ZENBUD", so it needs a smaller type ramp to stay on three lines. */
  .grow-with-zenbud--before-wholesale .hero-title {
    font-size: clamp(1.75rem, 4.2vw, 3.1rem);
    line-height: 1.1;
  }
  .grow-with-zenbud--before-wholesale .zb-hero-kicker {
    color: #fff;
    font-weight: 700;
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    margin: 14px 0 10px;
  }
  .grow-with-zenbud--before-wholesale .zb-hero-trust {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    margin: 18px 0 0;
    max-width: 34ch;
  }
  .grow-with-zenbud--before-wholesale .zb-hero-trust span {
    opacity: 0.45;
    padding: 0 4px;
  }
  .grow-with-zenbud h1.hero-title img {
    width: 2.5vw;
  }
  .grow-with-zenbud .hero-title {
        font-size: 3vw;
    }
  @media (max-width: 767.98px) {
    .grow-with-zenbud--before-wholesale .zb-hero-trust {
      max-width: none;
      text-align: center;
    }
  }
{%- endstyle -%}

<div class="grow-with-zenbud grow-with-zenbud--before-wholesale">

    <section class="container-fluid hero-container d-flex flex-column">
        <div class="row header-row">
            <div class="col-12 d-flex justify-content-center justify-content-md-start align-items-center">
                <a href="/" class="logo-link">
                    <img src="https://cdn.shopify.com/s/files/1/0858/0713/7087/files/zbd-footer-logo.png?v=1761123836" alt="ZenBud" class="logo-img">
                </a>
            </div>
        </div>

        <div class="row flex-grow-1">
            <div class="col-12 col-md-6 d-flex flex-column justify-content-between justify-content-md-start hero-content">
                <div>
                    <h1 class="hero-title">
                        <span class="font-light"><img src="https://cdn.shopify.com/s/files/1/0858/0713/7087/files/grow-with-zenbud-icon.png?v=1773861784" alt="" aria-hidden="true"> THE FIRST</span><br>
                        <span class="font-light">ULTRASOUND VAGUS</span><br>
                        <span class="font-bold">NERVE STIMULATOR</span>
                    </h1>
                    <p class="zb-hero-kicker">Published Science. Five-Minute Sessions. Your Margin.</p>
                    <p class="hero-paragraph">
                        Focused ultrasound to the auricular vagus &mdash; no current, no gel, no tingling. Stock the device your patients can measure on their own wearable.
                    </p>
                </div>

                <div class="hero-mobile-spacer flex-grow-1 d-md-none"></div>

                <div class="d-flex align-items-start hero-buttons-wrapper mt-auto mt-md-0 pb-md-0 flex-column">
                    <a href="#wholesale" class="btn-custom btn-orange">Open a Wholesale Account</a>
                    <a href="#affiliate" class="btn-custom btn-outline">Affiliate Program</a>
                    <p class="zb-hero-trust">Made in the USA <span aria-hidden="true">&middot;</span> Non-invasive <span aria-hidden="true">&middot;</span> 90-Day Guarantee <span aria-hidden="true">&middot;</span> HSA/FSA Eligible</p>
                </div>
            </div>
        </div>
    </section>

    <section class="container-fluid partnership-section">
        <div class="row">
            <div class="col-12 d-flex flex-column align-items-center">
                <h2 class="partnership-heading">Which Path Fits Your Practice?</h2>
                <p class="partnership-subheading">
                    Both paths let you bring <strong>clinical-grade vagal tone support</strong> to your patients and clients in their own home. <br><strong><em>The difference is whether you stock it or refer it.</em></strong>
                </p>
            </div>
        </div>

        <div class="row g-4 mt-2 mt-md-0">
            <div class="col-12 col-md-6">
                <div class="card-custom">
                    <h3 class="card-title">Wholesale Partner</h3>
                    <div class="list-row">
                        <div class="list-label">BUILT FOR:</div>
                        <div class="list-value">Integrative practitioners, pharmacies, clinics, wellness centers and studios</div>
                    </div>
                    <div class="list-row">
                        <div class="list-label">HOW IT WORKS:</div>
                        <div class="list-value">Buy 5+ units at wholesale, sell directly to patients in your practice</div>
                    </div>
                    <div class="list-row">
                        <div class="list-label">YOU EARN:</div>
                        <div class="list-value">The margin between wholesale and retail</div>
                    </div>
                    <div class="list-row">
                        <div class="list-label">INVENTORY:</div>
                        <div class="list-value">You hold stock</div>
                    </div>
                    <div class="list-row">
                        <div class="list-label">CHOOSE THIS IF:</div>
                        <div class="list-value">You have an active patient or client base and want ZenBud easily added to your protocols</div>
                    </div>
                    <div class="card-spacer"></div>
                    <a href="/pages/wholesale" class="btn-partnership btn-blue-gradient">Open a Wholesale Account</a>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="card-custom">
                    <h3 class="card-title">Affiliate Partner</h3>
                    <div class="list-row">
                        <div class="list-label">BUILT FOR:</div>
                        <div class="list-value">Remote practices, online apothecaries, telemedicine, online coaching, remote teaching programs and medical content creators</div>
                    </div>
                    <div class="list-row">
                        <div class="list-label">HOW IT WORKS:</div>
                        <div class="list-value">Share your referral link, earn margin on every patient or client purchase</div>
                    </div>
                    <div class="list-row">
                        <div class="list-label">YOU EARN:</div>
                        <div class="list-value">Margin per patient or client purchase</div>
                    </div>
                    <div class="list-row">
                        <div class="list-label">INVENTORY:</div>
                        <div class="list-value">None &mdash; ZenBud ships direct to your patient or client</div>
                    </div>
                    <div class="list-row">
                        <div class="list-label">CHOOSE THIS IF:</div>
                        <div class="list-value">Your patients or clients typically order online from home, and you'd rather keep your capital in the practice than on a shelf</div>
                    </div>
                    <div class="card-spacer"></div>
                    <a href="https://partners.zenbud.health/" class="btn-partnership btn-orange-gradient">Join the Affiliate Program</a>
                </div>
            </div>
        </div>
    </section>

    <section class="container-fluid p-0 wholesale-banner-section" id="wholesale">
        <div class="row g-0">
            <div class="col-12 col-md-6 wholesale-img-col"></div>
            <div class="col-12 col-md-6 wholesale-bg-col d-flex flex-column justify-content-center">
                <div class="wholesale-banner-title-wrap">
                    <h2 class="wholesale-banner-title"><img src="https://cdn.shopify.com/s/files/1/0858/0713/7087/files/wholesale-icon.png?v=1773801765" alt="" aria-hidden="true" class="wholesale-banner-icon" loading="lazy"> <strong>Wholesale</strong><br>Partner Program</h2>
                </div>
                <p class="wholesale-banner-subtitle">Buy at wholesale. Sell at retail.<br>Keep the margin.</p>
            </div>
        </div>
    </section>

    <section class="container-fluid wholesale-content-section">
        <div class="row">
            <div class="col-12">
                <p class="wholesale-intro-text">
                    Designed for practitioners, clinics, and wellness professionals who want to offer ZenBud directly to their clients. Purchase 5 or more units at a discounted wholesale price and resell them through your practice or storefront.
                </p>
            </div>
        </div>

        <div class="wholesale-features-grid">
            <div class="row g-0">
                <div class="col-12 col-md-6 feature-cell border-bottom-vw border-right-vw mobile-border-bottom">
                    <img src="https://cdn.shopify.com/s/files/1/0858/0713/7087/files/wholesale-pricing_20c91184-778b-4b9d-9273-507eb4d50e22.png?v=1779256594" alt="Wholesale Pricing" class="feature-icon" loading="lazy">
                    <div class="feature-text-content">
                        <h4 class="feature-title">Wholesale Pricing</h4>
                        <p class="feature-desc">Significant discount off retail on orders of 5+ units</p>
                    </div>
                </div>

                <div class="col-12 col-md-6 feature-cell border-bottom-vw mobile-border-bottom">
                    <img src="https://cdn.shopify.com/s/files/1/0858/0713/7087/files/practice-ready.png?v=1779256594" alt="Practice-Ready" class="feature-icon" loading="lazy">
                    <div class="feature-text-content">
                        <h4 class="feature-title">Practice-Ready</h4>
                        <p class="feature-desc">Integrative practitioners, pharmacies, clinics, wellness centers and studios</p>
                    </div>
                </div>

                <div class="col-12 col-md-6 feature-cell border-right-vw mobile-border-bottom">
                    <img src="https://cdn.shopify.com/s/files/1/0858/0713/7087/files/control-fulfillment.png?v=1779256593" alt="You Control Fulfillment" class="feature-icon" loading="lazy">
                    <div class="feature-text-content">
                        <h4 class="feature-title">You Control Fulfillment</h4>
                        <p class="feature-desc">Ship directly to clients or hand-deliver in your practice</p>
                    </div>
                </div>

                <div class="col-12 col-md-6 feature-cell">
                    <img src="https://cdn.shopify.com/s/files/1/0858/0713/7087/files/earning-potential.png?v=1779256594" alt="Unlimited Earning Potential" class="feature-icon" loading="lazy">
                    <div class="feature-text-content">
                        <h4 class="feature-title">Unlimited Earning Potential</h4>
                        <p class="feature-desc">The more you sell, the more you make</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4 mt-md-0">
            <div class="col-12 wholesale-cta-area">

            </div>
        </div>
    </section>
</div>

