{% comment %}
  Gaming-reaction-stats.liquid
  Animated reaction-time statistics.
  Each statistic counts from 0 to its assigned value once it enters the viewport.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --gaming-stats-bg: {{ section.settings.bg_color }};
    --gaming-stats-text: {{ section.settings.text_color }};

    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--gaming-stats-bg);
    display: flex;
  }

  #shopify-section-{{ section.id }} *,
  #shopify-section-{{ section.id }} *::before,
  #shopify-section-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .gaming-stats__container {
    width: 90vw;
    max-width: 90vw;
    margin: 0 auto;
    padding: 1.55vw 5vw 2.1vw;
  }

  #shopify-section-{{ section.id }} .gaming-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4.25vw;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .gaming-stats__item {
    min-width: 0;
    color: var(--gaming-stats-text);
  }

  #shopify-section-{{ section.id }} .gaming-stats__value {
    display: flex;
    align-items: baseline;
    gap: 0.25em;

    margin: 0 0 0.25vw;

    color: var(--gaming-stats-text);
    font-family: inherit;
    font-size: 1.87vw;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .gaming-stats__number,
  #shopify-section-{{ section.id }} .gaming-stats__suffix {
    color: inherit;
    font: inherit;
  }

  #shopify-section-{{ section.id }} .gaming-stats__label {
    max-width: 15vw;
    margin: 0;

    color: var(--gaming-stats-text);
    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 400;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .gaming-stats__footnote {
    margin: 1.1vw auto 0;

    color: var(--gaming-stats-text);
    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 400;
    line-height: 1.6;
    text-align: center;
  }

  @media screen and (min-width: 767px) and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .gaming-stats__container {
      padding: 4vw 2vw;
    }

    #shopify-section-{{ section.id }} .gaming-stats__grid {
      gap: 3vw;
    }

    #shopify-section-{{ section.id }} .gaming-stats__value {
      font-size: 3vw;
    }

    #shopify-section-{{ section.id }} .gaming-stats__label,
    #shopify-section-{{ section.id }} .gaming-stats__footnote {
      font-size: 1.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-stats__label {
      max-width: 19vw;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .gaming-stats__container {
      width: 90vw;
      max-width: 90vw;
      padding: 8vw 0;
    }

    #shopify-section-{{ section.id }} .gaming-stats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 7vw 6vw;
    }

    #shopify-section-{{ section.id }} .gaming-stats__value {
      margin-bottom: 1vw;
      font-size: 7vw;
    }

    #shopify-section-{{ section.id }} .gaming-stats__label {
      max-width: 100%;
      font-size: 3.8vw;
      line-height: 1.45;
    }

    #shopify-section-{{ section.id }} .gaming-stats__footnote {
      margin-top: 8vw;
      font-size: 3.8vw;
      line-height: 1.5;
    }
  }

  @media screen and (max-width: 479px) {
    #shopify-section-{{ section.id }} .gaming-stats__grid {
      grid-template-columns: 1fr 1fr;
      gap: 7vw;
    }
  }
</style>

<div class="gaming-stats__container">
  {%- if section.blocks.size > 0 -%}
    <div class="gaming-stats__grid">
      {%- for block in section.blocks -%}
        <div
          class="gaming-stats__item"
          {{ block.shopify_attributes }}
        >
          <div
            class="gaming-stats__value"
            aria-label="{{ block.settings.value | escape }}{{ block.settings.suffix | escape }} {{ block.settings.label | escape }}"
          >
            <span
              class="gaming-stats__number"
              data-counter
              data-target="{{ block.settings.value | escape }}"
              data-decimals="{{ block.settings.decimal_places }}"
              aria-hidden="true"
            >
              0
            </span>

            {%- if block.settings.suffix != blank -%}
              <span
                class="gaming-stats__suffix"
                aria-hidden="true"
              >
                {{ block.settings.suffix | escape }}
              </span>
            {%- endif -%}
          </div>

          {%- if block.settings.label != blank -%}
            <p class="gaming-stats__label">
              {{ block.settings.label | escape }}
            </p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.footnote != blank -%}
    <p class="gaming-stats__footnote">
      {{ section.settings.footnote | escape }}
    </p>
  {%- endif -%}
</div>

<script>
  (() => {
    const sectionId = 'shopify-section-{{ section.id }}';

    const initializeGamingCounters = () => {
      const section = document.getElementById(sectionId);

      if (!section || section.dataset.gamingCountersInitialized === 'true') {
        return;
      }

      section.dataset.gamingCountersInitialized = 'true';

      const counters = section.querySelectorAll('[data-counter]');

      if (!counters.length) {
        return;
      }

      const duration = {{ section.settings.animation_duration | times: 1000 }};
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const formatValue = (value, decimals) => {
        return Number(value).toFixed(decimals);
      };

      const setCounterFinalValue = (counter) => {
        const target = parseFloat(counter.dataset.target) || 0;
        const decimals = parseInt(counter.dataset.decimals, 10) || 0;

        counter.textContent = formatValue(target, decimals);
      };

      const animateCounter = (counter) => {
        if (counter.dataset.animated === 'true') {
          return;
        }

        counter.dataset.animated = 'true';

        const target = parseFloat(counter.dataset.target) || 0;
        const decimals = parseInt(counter.dataset.decimals, 10) || 0;

        if (reduceMotion || duration <= 0) {
          setCounterFinalValue(counter);
          return;
        }

        const startTime = performance.now();

        const update = (currentTime) => {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);

          const easedProgress = 1 - Math.pow(1 - progress, 3);
          const currentValue = target * easedProgress;

          counter.textContent = formatValue(currentValue, decimals);

          if (progress < 1) {
            requestAnimationFrame(update);
          } else {
            setCounterFinalValue(counter);
          }
        };

        requestAnimationFrame(update);
      };

      if (!('IntersectionObserver' in window)) {
        counters.forEach(animateCounter);
        return;
      }

      const observer = new IntersectionObserver(
        (entries, currentObserver) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }

            animateCounter(entry.target);
            currentObserver.unobserve(entry.target);
          });
        },
        {
          threshold: 0.35
        }
      );

      counters.forEach((counter) => {
        counter.textContent = '0';
        observer.observe(counter);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeGamingCounters, {
        once: true
      });
    } else {
      initializeGamingCounters();
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (event.target && event.target.id === sectionId) {
        event.target.dataset.gamingCountersInitialized = 'false';
        initializeGamingCounters();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Gaming-Reaction Stats",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#3367DD"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Measured on a simple reaction-time task in healthy adults. Gaming-specific validation is in progress."
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Counter duration",
      "min": 0.5,
      "max": 3,
      "step": 0.1,
      "unit": "s",
      "default": 1.5
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Counter value",
          "default": "21.1",
          "info": "Enter numbers only. Example: 21.1"
        },
        {
          "type": "range",
          "id": "decimal_places",
          "label": "Decimal places",
          "min": 0,
          "max": 2,
          "step": 1,
          "default": 1
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "ms"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Description",
          "default": "Active-group improvement"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gaming-Reaction Stats",
      "category": "Home Revamp",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "21.1",
            "decimal_places": 1,
            "suffix": "ms",
            "label": "Active-group improvement"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "4.9",
            "decimal_places": 1,
            "suffix": "ms",
            "label": "Sham-group improvement"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "16.2",
            "decimal_places": 1,
            "suffix": "ms",
            "label": "Net active-over-sham difference"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "76.7",
            "decimal_places": 1,
            "suffix": "%",
            "label": "Active responders at ≥20 ms (sham: 3.3%)"
          }
        }
      ]
    }
  ]
}
{% endschema %}