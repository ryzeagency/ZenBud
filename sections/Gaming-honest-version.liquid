{% comment %}
  Gaming-honest-version.liquid

  "What we know. What we don't." comparison section.

  Typography baseline:
  Desktop heading: 1.87vw
  Desktop paragraph: 0.83vw

  Main container: 90vw
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    display: flex;
    --gaming-honest-bg: {{ section.settings.bg_color }};
    --gaming-honest-heading: {{ section.settings.heading_color }};
    --gaming-honest-accent: {{ section.settings.accent_color }};
    --gaming-honest-support-bg: {{ section.settings.support_card_bg }};
    --gaming-honest-unproven-bg: {{ section.settings.unproven_card_bg }};
    --gaming-honest-card-text: {{ section.settings.card_text_color }};

    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--gaming-honest-bg);
  }

  #shopify-section-{{ section.id }} *,
  #shopify-section-{{ section.id }} *::before,
  #shopify-section-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .gaming-honest__container {
    width: 90vw;
    max-width: 90vw;
    margin: 0 auto;

    padding-top: 1vw;
    padding-bottom: 3.2vw;
  }

  /* ============================
     HEADING
     ============================ */

  #shopify-section-{{ section.id }} .gaming-honest__header {
    margin-left: 3vw;
    margin-bottom: 1.55vw;
  }

  #shopify-section-{{ section.id }} .gaming-honest__eyebrow {
    margin: 0 0 0.35vw;

    color: var(--gaming-honest-accent);
    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .gaming-honest__heading {
    margin: 0;

    color: var(--gaming-honest-heading);
    font-family: inherit;
    font-size: 1.87vw;
    font-weight: 700;
    line-height: 1.3;
  }

  /* ============================
     CARDS
     ============================ */

  #shopify-section-{{ section.id }} .gaming-honest__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.15vw;
  }

  #shopify-section-{{ section.id }} .gaming-honest__card {
    min-width: 0;
    min-height: 19vw;

    padding: 2.25vw 2.8vw;

    color: var(--gaming-honest-card-text);

    border-radius: 0.55vw;
  }

  #shopify-section-{{ section.id }} .gaming-honest__card--supports {
    background-color: var(--gaming-honest-support-bg);
  }

  #shopify-section-{{ section.id }} .gaming-honest__card--unproven {
    background-color: var(--gaming-honest-unproven-bg);
  }

  #shopify-section-{{ section.id }} .gaming-honest__card-title {
    margin: 0 0 1vw;

    color: var(--gaming-honest-card-text);
    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* ============================
     LIST
     ============================ */

  #shopify-section-{{ section.id }} .gaming-honest__list {
    display: flex;
    flex-direction: column;
    gap: 0.82vw;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  #shopify-section-{{ section.id }} .gaming-honest__item {
    display: grid;
    grid-template-columns: 1vw minmax(0, 1fr);
    align-items: start;
    column-gap: 0.65vw;

    margin: 0;
    padding: 0;

    color: var(--gaming-honest-card-text);
    font-family: inherit;
    font-size: 0.83vw;
    font-weight: 400;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .gaming-honest__icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 1vw;
    height: 1.35em;

    color: var(--gaming-honest-card-text);

    font-family: Arial, sans-serif;
    font-size: 0.95vw;
    font-weight: 700;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .gaming-honest__icon img {
    display: block;
    width: 0.8vw;
    height: 0.8vw;
    object-fit: contain;
  }

  /* ============================
     TABLET
     ============================ */

  @media screen and (min-width: 767px) and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .gaming-honest__container {
      padding-top: 3vw;
      padding-bottom: 7.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__header {
      margin-left: 0;
      margin-bottom: 3vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__eyebrow,
    #shopify-section-{{ section.id }} .gaming-honest__card-title,
    #shopify-section-{{ section.id }} .gaming-honest__item {
      font-size: 1.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__heading {
      font-size: 3vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__card {
      min-height: 27vw;
      padding: 3vw;
      border-radius: 1vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__list {
      gap: 1.4vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__item {
      grid-template-columns: 1.8vw minmax(0, 1fr);
      gap: 1vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__icon {
      width: 1.8vw;
      font-size: 1.8vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__icon img {
      width: 1.5vw;
      height: 1.5vw;
    }
  }

  /* ============================
     MOBILE
     ============================ */

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .gaming-honest__container {
      width: 90vw;
      max-width: 90vw;

      padding-top: 5vw;
      padding-bottom: 10vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__header {
      margin-left: 0;
      margin-bottom: 6vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__eyebrow {
      margin-bottom: 2vw;
      font-size: 3.8vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__heading {
      font-size: 7vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__cards {
      grid-template-columns: 1fr;
      gap: 5vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__card {
      min-height: 0;

      padding: 7vw 6vw;

      border-radius: 3vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__card-title {
      margin-bottom: 5vw;
      font-size: 3.8vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__list {
      gap: 4vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__item {
      grid-template-columns: 5vw minmax(0, 1fr);
      column-gap: 2.5vw;

      font-size: 3.8vw;
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .gaming-honest__icon {
      width: 5vw;
      height: 1.5em;

      font-size: 4.5vw;
    }

    #shopify-section-{{ section.id }} .gaming-honest__icon img {
      width: 3.8vw;
      height: 3.8vw;
    }
  }
</style>

<div class="gaming-honest__container">

  <header class="gaming-honest__header">

    {%- if section.settings.eyebrow != blank -%}
      <p class="gaming-honest__eyebrow">
        {{ section.settings.eyebrow | escape }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="gaming-honest__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

  </header>

  <div class="gaming-honest__cards">

    <article class="gaming-honest__card gaming-honest__card--supports">

      {%- if section.settings.support_title != blank -%}
        <h3 class="gaming-honest__card-title">
          {{ section.settings.support_title | escape }}
        </h3>
      {%- endif -%}

      <ul class="gaming-honest__list">

        {%- for block in section.blocks -%}
          {%- if block.type == 'support_item' -%}

            <li
              class="gaming-honest__item"
              {{ block.shopify_attributes }}
            >
              <span
                class="gaming-honest__icon"
                aria-hidden="true"
              >
                {%- if section.settings.check_icon != blank -%}
                  {{
                    section.settings.check_icon
                    | image_url: width: 80
                    | image_tag:
                      loading: 'lazy',
                      alt: ''
                  }}
                {%- else -%}
                  ✓
                {%- endif -%}
              </span>

              <span>
                {{ block.settings.text | escape }}
              </span>
            </li>

          {%- endif -%}
        {%- endfor -%}

      </ul>

    </article>

    <article class="gaming-honest__card gaming-honest__card--unproven">

      {%- if section.settings.unproven_title != blank -%}
        <h3 class="gaming-honest__card-title">
          {{ section.settings.unproven_title | escape }}
        </h3>
      {%- endif -%}

      <ul class="gaming-honest__list">

        {%- for block in section.blocks -%}
          {%- if block.type == 'unproven_item' -%}

            <li
              class="gaming-honest__item"
              {{ block.shopify_attributes }}
            >
              <span
                class="gaming-honest__icon"
                aria-hidden="true"
              >
                {%- if section.settings.cross_icon != blank -%}
                  {{
                    section.settings.cross_icon
                    | image_url: width: 80
                    | image_tag:
                      loading: 'lazy',
                      alt: ''
                  }}
                {%- else -%}
                  ×
                {%- endif -%}
              </span>

              <span>
                {{ block.settings.text | escape }}
              </span>
            </li>

          {%- endif -%}
        {%- endfor -%}

      </ul>

    </article>

  </div>

</div>

